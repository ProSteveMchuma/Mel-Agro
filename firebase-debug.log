[debug] [2026-08-06T14:58:08.063Z] <<< [apiv2][body] POST https://firebaserules.googleapis.com/v1/projects/melagri/rulesets {"name":"projects/melagri/rulesets/22f9fc1f-7390-47c5-9215-cee3e73182fa","source":{"files":[{"content":"rules_version = '2';\r\nservice cloud.firestore {\r\n  match /databases/{database}/documents {\r\n    // Robust helper function to check if user is admin or super-admin\n    function isAdmin() {\n      return request.auth != null &&\n        exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&\n        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('role', 'user') in ['admin', 'super-admin'];\n    }\n\r\n    // Products: public catalog, server/admin inventory mutations only.\n    match /products/{productId} {\n      allow read: if true;\n      allow write: if isAdmin();\n    }\n\n    // Inventory history is written by trusted server routes or admins.\n    match /inventory_history/{historyId} {\n      allow read: if isAdmin();\n      allow write: if isAdmin();\n    }\n\n    // Customer orders are created/cancelled by server-authoritative API routes.\n    match /orders/{orderId} {\n      allow create: if isAdmin();\n      allow read: if request.auth != null && (resource.data.userId == request.auth.uid || isAdmin());\n      // Customers may only request a return. Payment and status changes are server/admin only.\n      allow update: if request.auth != null && (\n        isAdmin() || (\n          resource.data.userId == request.auth.uid && (\n            request.resource.data.diff(resource.data).affectedKeys().hasOnly(['returnStatus', 'returnReason']) &&\n            request.resource.data.get('paymentStatus', resource.data.get('paymentStatus', 'Unpaid')) == resource.data.get('paymentStatus', 'Unpaid') &&\n            request.resource.data.get('total', resource.data.get('total', 0)) == resource.data.get('total', 0) &&\n            request.resource.data.get('userId', resource.data.get('userId', '')) == resource.data.get('userId', '') &&\n            (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['returnStatus']) ||\n              request.resource.data.returnStatus == 'Requested')\n          )\r\n        )\r\n      );\r\n    }\r\n\r\n    // Users: Users can read/update their own profile (excluding sensitive fields),\r\n    // admins can manage all. Role / status / loyaltyPoints can ONLY be changed by an admin\r\n    match /users/{userId} {\r\n      allow read: if isAdmin() || (request.auth != null && request.auth.uid == userId);\r\n      allow create: if request.auth != null && request.auth.uid == userId && request.resource.data.get('role', 'user') == 'user';\r\n      allow update: if (\r\n        isAdmin() ||\r\n        (request.auth != null && request.auth.uid == userId &&\r\n         !request.resource.data.diff(resource.data).affectedKeys().hasAny(['role', 'status', 'loyaltyPoints']))\r\n      );\r\n      allow delete: if isAdmin();\r\n    }\r\n\r\n    // Transactions are written by payment APIs (Admin SDK) or admins.\n    match /transactions/{id} {\n        allow read: if isAdmin();\n        allow create: if isAdmin();\n    }\r\n\r\n    // Settings: Public read (for shipping rates), Admin write\r\n    match /settings/{settingId} {\r\n      allow read: if true;\r\n      allow write: if isAdmin();\r\n    }\r\n\r\n    // Shipping zones: Public read (checkout reads to compute delivery cost), Admin write\r\n    match /shipping_zones/{zoneId} {\r\n      allow read: if true;\r\n      allow write: if isAdmin();\r\n    }\r\n    \r\n    // Content: Public read, Admin write (for banners etc)\r\n    match /content/{docId} {\r\n      allow read: if true;\r\n      allow write: if isAdmin();\r\n    }\r\n    \r\n    // Reviews: Public read, Authenticated create\r\n    match /reviews/{reviewId} {\r\n      allow read: if true;\r\n      allow create: if request.auth != null && request.resource.data.userId == request.auth.uid;\r\n      allow update, delete: if request.auth != null && request.auth.uid == resource.data.userId;\r\n    }\r\n\r\n    // Wishlist: Private to user\r\n    match /wishlist/{wishlistId} {\r\n      allow read, write: if request.auth != null && request.auth.uid == wishlistId;\r\n    }\r\n\r\n    // Notifications: customers can only create/read their own; server handles order notices.\n    match /notifications/{notificationId} {\n      allow create: if request.auth != null && (request.resource.data.userId == request.auth.uid || isAdmin());\n      allow read, update: if request.auth != null && (resource.data.userId == request.auth.uid || isAdmin());\n    }\r\n\r\n    // Messages: Users can create and read own. Admin can read/write all.\r\n    match /messages/{messageId} {\r\n      allow create: if request.auth != null && request.resource.data.userId == request.auth.uid;\r\n      allow read, update: if request.auth != null && (resource.data.userId == request.auth.uid || isAdmin());\r\n    }\r\n\r\n    // Analytics aggregates are server-authoritative. Clients use /api/analytics.\n    match /analytics_search_terms/{id} {\r\n      allow read, delete: if isAdmin();\r\n      allow write: if false;\n    }\r\n    match /analytics_products/{id} {\r\n      allow read, delete: if isAdmin();\r\n      allow write: if false;\n    }\r\n    match /analytics_traffic/{id} {\r\n      allow read, delete: if isAdmin();\r\n      allow write: if false;\n    }\r\n    match /analytics_funnels/{id} {\r\n      allow read, delete: if isAdmin();\r\n      allow create, update: if request.auth != null && request.auth.uid == id;\r\n    }\r\n    match /analytics_purchases/{id} {\n      allow read, delete: if isAdmin();\n      allow write: if false;\n    }\n    match /analytics_recommendations/{id} {\n      allow read, delete: if isAdmin();\n      allow write: if false;\n    }\n    match /analytics_visit_dedup/{id} {\n      allow read: if false;\n      allow write: if false;\n    }\n\r\n    // Carts: Private to user\r\n    match /carts/{userId} {\r\n      allow read, write: if request.auth != null && request.auth.uid == userId;\r\n    }\r\n    \r\n    // Discounts/Coupons: Public read, Admin write\r\n    match /discounts/{id} {\r\n      allow read: if true;\r\n      allow write: if isAdmin();\r\n    }\r\n\r\n    // M-Pesa C2B payment audit log: written only by server (admin SDK bypasses), admin reads\r\n    match /c2bPayments/{id} {\r\n      allow read: if isAdmin();\r\n      allow write: if false;\r\n    }\r\n\r\n    // M-Pesa refunds audit log: written only by server (admin SDK bypasses), admin reads\r\n    match /refunds/{id} {\r\n      allow read: if isAdmin();\r\n      allow write: if false;\r\n    }\r\n\r\n    // M-Pesa configuration (C2B URL registration state): admin only\r\n    match /mpesaConfig/{id} {\r\n      allow read: if isAdmin();\r\n      allow write: if false;\r\n    }\r\n\r\n    // Paystack webhook idempotency log: server only\r\n    match /paystackWebhookEvents/{id} {\r\n      allow read: if isAdmin();\r\n      allow write: if false;\r\n    }\r\n\r\n    // AI Insights cache: server-only writes (admin SDK bypasses), admin read\r\n    match /aiInsights/{id} {\n      allow read: if isAdmin();\r\n      allow write: if false;\r\n    }\n    match /intelligence_alerts/{id} {\n      allow read: if isAdmin();\n      allow write: if false;\n    }\n\r\n    // Bulk inquiry submissions from /bulk page: server-only writes (via API), admin read\r\n    match /bulkInquiries/{id} {\r\n      allow read, update: if isAdmin();\r\n      allow create, delete: if false;\r\n    }\r\n\r\n    // Discount usage tracking: server only\r\n    match /discountUsage/{id} {\r\n      allow read: if isAdmin();\r\n      allow write: if false;\r\n    }\r\n  }\r\n}\r\n\r\n\r\n\r\n","name":"firestore.rules"}]},"createTime":"2026-08-06T14:58:07.560991Z","metadata":{"services":["cloud.firestore"]}}
