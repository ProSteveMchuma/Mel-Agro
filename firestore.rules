rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Robust helper function to check if user is admin or super-admin
    function isAdmin() {
      return request.auth != null &&
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('role', 'user') in ['admin', 'super-admin'];
    }
    function hasPermission(permission) {
      let account = get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
      return isAdmin() && (
        account.get('role', 'user') == 'super-admin' ||
        !account.keys().hasAny(['adminPermissions']) ||
        permission in account.adminPermissions
      );
    }

    // Products: public catalog, server/admin inventory mutations only.
    match /products/{productId} {
      allow read: if true;
      allow write: if hasPermission('catalogue.manage');
    }

    // Inventory history is written by trusted server routes or admins.
    match /inventory_history/{historyId} {
      allow read: if isAdmin();
      allow write: if hasPermission('catalogue.manage');
    }

    // Customer orders are created/cancelled by server-authoritative API routes.
    match /orders/{orderId} {
      allow create: if hasPermission('orders.manage');
      allow read: if request.auth != null && (resource.data.userId == request.auth.uid || isAdmin());
      // Customers may only request a return. Payment and status changes are server/admin only.
      allow update: if request.auth != null && (
        hasPermission('orders.manage') || (
          resource.data.userId == request.auth.uid && (
            request.resource.data.diff(resource.data).affectedKeys().hasOnly(['returnStatus', 'returnReason']) &&
            request.resource.data.get('paymentStatus', resource.data.get('paymentStatus', 'Unpaid')) == resource.data.get('paymentStatus', 'Unpaid') &&
            request.resource.data.get('total', resource.data.get('total', 0)) == resource.data.get('total', 0) &&
            request.resource.data.get('userId', resource.data.get('userId', '')) == resource.data.get('userId', '') &&
            (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['returnStatus']) ||
              request.resource.data.returnStatus == 'Requested')
          )
        )
      );
    }

    // Users: Users can read/update their own profile (excluding sensitive fields),
    // admins can manage all. Role / status / loyaltyPoints can ONLY be changed by an admin
    match /users/{userId} {
      allow read: if isAdmin() || (request.auth != null && request.auth.uid == userId);
      allow create: if request.auth != null && request.auth.uid == userId && request.resource.data.get('role', 'user') == 'user';
      allow update: if (
        hasPermission('customers.manage') ||
        (request.auth != null && request.auth.uid == userId &&
         !request.resource.data.diff(resource.data).affectedKeys().hasAny(['role', 'status', 'loyaltyPoints']))
      );
      allow delete: if hasPermission('customers.manage');
    }

    // Transactions are written by payment APIs (Admin SDK) or admins.
    match /transactions/{id} {
        allow read: if isAdmin();
        allow create: if isAdmin();
    }

    // Settings: Public read (for shipping rates), Admin write
    match /settings/{settingId} {
      allow read: if true;
      allow write: if hasPermission('settings.manage');
    }

    // Shipping zones: Public read (checkout reads to compute delivery cost), Admin write
    match /shipping_zones/{zoneId} {
      allow read: if true;
      allow write: if hasPermission('settings.manage');
    }
    
    // Content: Public read, Admin write (for banners etc)
    match /content/{docId} {
      allow read: if true;
      allow write: if hasPermission('marketing.manage');
    }
    
    // Reviews: Public read, Authenticated create
    match /reviews/{reviewId} {
      allow read: if true;
      allow create: if request.auth != null && request.resource.data.userId == request.auth.uid;
      allow update, delete: if request.auth != null && request.auth.uid == resource.data.userId;
    }

    // Wishlist: Private to user
    match /wishlist/{wishlistId} {
      allow read, write: if request.auth != null && request.auth.uid == wishlistId;
    }

    // Notifications: customers can only create/read their own; server handles order notices.
    match /notifications/{notificationId} {
      allow create: if request.auth != null && (request.resource.data.userId == request.auth.uid || isAdmin());
      allow read, update: if request.auth != null && (resource.data.userId == request.auth.uid || isAdmin());
    }

    // Messages: Users can create and read own. Admin can read/write all.
    match /messages/{messageId} {
      allow create: if request.auth != null && request.resource.data.userId == request.auth.uid;
      allow read, update: if request.auth != null && (resource.data.userId == request.auth.uid || isAdmin());
    }

    // Analytics aggregates are server-authoritative. Clients use /api/analytics.
    match /analytics_search_terms/{id} {
      allow read, delete: if isAdmin();
      allow write: if false;
    }
    match /analytics_products/{id} {
      allow read, delete: if isAdmin();
      allow write: if false;
    }
    match /analytics_traffic/{id} {
      allow read, delete: if isAdmin();
      allow write: if false;
    }
    match /analytics_funnels/{id} {
      allow read, delete: if isAdmin();
      allow create, update: if request.auth != null && request.auth.uid == id;
    }
    match /analytics_purchases/{id} {
      allow read, delete: if isAdmin();
      allow write: if false;
    }
    match /analytics_recommendations/{id} {
      allow read, delete: if isAdmin();
      allow write: if false;
    }
    match /analytics_visit_dedup/{id} {
      allow read: if false;
      allow write: if false;
    }

    // Carts: Private to user
    match /carts/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }
    
    // Discounts/Coupons: Public read, Admin write
    match /discounts/{id} {
      allow read: if true;
      allow write: if hasPermission('catalogue.manage');
    }

    // M-Pesa C2B payment audit log: written only by server (admin SDK bypasses), admin reads
    match /c2bPayments/{id} {
      allow read: if isAdmin();
      allow write: if false;
    }

    // M-Pesa refunds audit log: written only by server (admin SDK bypasses), admin reads
    match /refunds/{id} {
      allow read: if isAdmin();
      allow write: if false;
    }

    // M-Pesa configuration (C2B URL registration state): admin only
    match /mpesaConfig/{id} {
      allow read: if isAdmin();
      allow write: if false;
    }

    // Paystack webhook idempotency log: server only
    match /paystackWebhookEvents/{id} {
      allow read: if isAdmin();
      allow write: if false;
    }

    // AI Insights cache: server-only writes (admin SDK bypasses), admin read
    match /aiInsights/{id} {
      allow read: if isAdmin();
      allow write: if false;
    }
    match /intelligence_alerts/{id} {
      allow read: if isAdmin();
      allow write: if false;
    }

    // Bulk inquiry submissions from /bulk page: server-only writes (via API), admin read
    match /bulkInquiries/{id} {
      allow read, update: if isAdmin();
      allow create, delete: if false;
    }

    // Newsletter addresses are collected by the validated server endpoint only.
    match /newsletterSubscriptions/{id} {
      allow read, update, delete: if isAdmin();
      allow create: if false;
    }

    match /adminAuditLog/{id} {
      allow read: if isAdmin();
      allow write: if false;
    }
    match /automationRules/{id} {
      allow read, write: if false;
    }
    match /automationRuns/{id} {
      allow read, write: if false;
    }
    match /adminAnalyticsPreferences/{id} {
      allow read, write: if false;
    }

    // Discount usage tracking: server only
    match /discountUsage/{id} {
      allow read: if isAdmin();
      allow write: if false;
    }
  }
}



